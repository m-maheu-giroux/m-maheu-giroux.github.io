# --- Lecture 7 STI ----
c <- 1.5
p <- 0.75
r <- 2/12
p_l <- 0.97
p_h <- 1 - p_l
c_h <- 26
c_l <- (c - c_h * p_h)/p_l
g_h <- (c_h * p_h) / (c_l * p_l + c_h * p_h)
g_l <- 1 - g_h
R_l <- c_l * p * r
R_h <- c_h * p * r
ngm <- matrix(c(R_l * g_l, R_l * g_h,
R_h * g_l, R_h * g_h), ncol = 2 , nrow = 2)
round(eigen(ngm)$values[1], 2)
# NG model
NGmod <- function(Q = 0, end = 5, dt = 0.005, R0 = 1.73) {
N <- 10000
I <- 1
S <- N - I
p <- 0.75
mu <- 1/25    #
pr_lw <- 0.97
pr_hg <- 1 - pr_lw
c <- 1.5
c_hg <- 26
c_lw <- (c - c_hg * pr_hg) / (1 - pr_hg)
g_hh <- (Q * c_lw * pr_lw + c_hg * pr_hg) / (c_hg * pr_hg + c_lw * pr_lw)
g_lh <- 1 - g_hh
g_hl <- (1 - g_hh) * (c_hg * pr_hg) / (c_lw * pr_lw)
g_ll <- 1 - g_hl
mix <- matrix(c(g_ll,
g_hl,
g_lh,
g_hh),
nrow = 2, byrow = TRUE)
gamma <- ((g_hh * c_hg * p  + g_ll* c_lw * p ) / R0) # We fix R0 to 1.73 in all scenarios
lw <- 1
hg <- 2
start <- 0    # Starting time
time <- seq(start, end, by = dt)
niter <- (end - start) / dt + 1
X <- array(data = 0, dim = c(2, 2, niter))
X[1, lw, 1] <- pr_lw * S
X[2, lw, 1] <- pr_lw * I
X[1, hg, 1] <- pr_hg * S
X[2, hg, 1] <- pr_hg * I
Xt <- X[,,1]
for ( i in 2:niter) {
# First the young
FOI_lw <- (mix[lw, lw] * c_lw * p * (Xt[2, lw]/sum(Xt[, lw])) +
mix[lw, hg] * c_lw * p * (Xt[2, hg]/sum(Xt[, hg]))) * Xt[1, lw]
X[1, lw, i] <- Xt[1, lw] + dt*(mu * sum(Xt[, lw]) + gamma * Xt[2, lw] - FOI_lw - mu * Xt[1, lw])
X[2, lw, i] <- Xt[2, lw] + dt*(FOI_lw - (mu + gamma) * Xt[2, lw] )
FOI_hg <- (mix[hg, lw] * c_hg * p * (Xt[2, lw]/sum(Xt[, lw])) +
mix[hg, hg] * c_hg * p * (Xt[2, hg]/sum(Xt[, hg]))) * Xt[1, hg]
X[1, hg, i] <- Xt[1, hg] + dt*(mu * sum(Xt[, hg]) + gamma * Xt[2, hg] - FOI_hg - mu * Xt[1, hg])
X[2, hg, i] <- Xt[2, hg] + dt*(FOI_hg - (mu + gamma) * Xt[2, hg] )
Xt <- X[,,i]
}
return(list(X, time)) }
X1 <- NGmod(Q = 0, end = 10)
plot(colSums(X1[[1]][2, , ])/sum(X1[[1]][,,1]) ~ X1[[2]], type = 'l', ylim = c(0, 0.05), col = 'violetred4',
lwd = 2, ylab = 'Prevalence', xlab = 'Time (years)', lty = 1)
XD <- NGmod(Q = -0.8, end = 10)
lines(colSums(XD[[1]][2, , ])/sum(XD[[1]][,,1]) ~ XD[[2]], lty = 2, col = 'violetred4', lwd = 2)
XA <- NGmod(Q = 0.8, end = 10)
lines(colSums(XA[[1]][2, , ])/sum(XA[[1]][,,1]) ~ XA[[2]], lty = 3, col = 'violetred4', lwd = 2)
legend('topleft', legend = c('Proportional', 'Disassortative (Q = - 0.8)', 'Assortative (Q = 0.8)'), col = 'violetred4',
lty = c(1, 2, 3), bty = 'n')
