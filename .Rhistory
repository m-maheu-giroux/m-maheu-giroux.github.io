lines(colSums(XA[[1]][2, , ])/sum(XA[[1]][,,1]) ~ XA[[2]], lty = 3, col = 'violetred4', lwd = 2)
legend('topleft', legend = c('Proportional', 'Disassortative (Q = - 0.8)', 'Assortative (Q = 0.8)'), col = 'violetred4',
lty = c(1, 2, 3), bty = 'n')
