install.packages("devtools")
devtools::install_github("hadley/emo")
library(data.table)
library(knitr)
devtools::load_all("~/Google Drive/McGill/Research/Wisbech/first90/R")
# ---- Input Country Here ---
cnt <- "Senegal"
age_group <- c('15-24','25-34','35-49')
# Read PJNZ file(s)
pjnz <- "~/Google Drive/McGill/Research/Wisbech/Spectrum files/Senegal_2018_final_v5_63.pjnz"
fp <- prepare_inputs(pjnz)
plot_pjnz(fp)
# All surveys should be included. If serology was not collected, the model should
# be fitted overall
data(survey_hts)
dat <- dat_test <- select_hts(survey_hts, cnt, age_group)
# We prepare the survey data
data(prgm_dat)
prg_dat <- select_prgmdata(prgm_dat, cnt, age_group)
plot_inputdata(prg_dat, fp)
likdat <- prepare_hts_likdat(dat, prg_dat, fp)
View(lidat)
View(likdat)
View(likdat$evertest)
d_idu = 1/15
I <- 1000     # Total population
E <- 0
mu <- 1/(65-15)  # Mortality
inj <- 1/15  # 1/Duration of injecting career
dt <- 0.01    # Time step
Start <- 0    # Starting time
End <- 300     # Ending Time
Time <- seq(Start, End, by = dt)
Niter <- (End - Start)/dt + 1
X <- array(data = 0, dim = c(2, Niter))
X[1,1] <- I
X[2,1] <- E
Nt <- sum(Xt)
Xt <- X[,1]
# The main iteration loop
for ( i in 2:Niter){
X[1, i] <- Xt[1] + dt*(Nt*mu - (mu + inj)*Xt[1])
X[2, i] <- Xt[2] + dt*((mu + inj)*Xt[1] - mu*Xt[2] )
Xt <- X[, i]
Nt <- sum(Xt)
}
head(t(X),10)
